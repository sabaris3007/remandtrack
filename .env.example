# Server port
PORT=3000

# AES-256-GCM encryption key for case data (64-char hex = 32 bytes)
# Auto-generated on first run if not set.
# Generate manually: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CASE_ENCRYPTION_KEY=

# Python microservice URLs (defaults work for local dev and Docker)
PDF_SERVICE_URL=http://127.0.0.1:8001
AUDIT_SERVICE_URL=http://127.0.0.1:8002
